{
  "name": "spectrum",
  "version": "2.3.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace apps/backend run dev\" \"npm --workspace apps/frontend run dev\"",
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "build": "npm --workspace apps/frontend run build",
    "start": "node apps/backend/src/index.js",
    "preview": "npm --workspace apps/frontend run preview",
    "test": "npm --workspace apps/backend run test",
    "typecheck": "npm --workspace apps/frontend run typecheck",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "native:build": "node scripts/native.mjs",
    "checkers:update": "node scripts/native.mjs all --update",
    "checkers:verify": "node scripts/native.mjs verify",
    "test:agents": "node scripts/check-agents.mjs",
    "xjyutping:sync": "node scripts/xjyutping.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "concurrently": "^10.0.6",
    "debug": "4.4.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "codemirror-lang-typst": "0.6.0"
  }
}
