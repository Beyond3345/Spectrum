<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 26+: the Liquid Glass icon in Resources/Assets.car (compiled from icons/AppIcon.icon); older systems use icon.icns -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- what macOS says when Spectrum first reaches into a cloud location kept by OneDrive, Dropbox, Google Drive or Synology Drive -->
	<key>NSFileProviderDomainUsageDescription</key>
	<string>Spectrum keeps your cloud projects in step with their copies in this folder.</string>
</dict>
</plist>
