<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 26+: the Liquid Glass icon in Resources/Assets.car (compiled from icons/AppIcon.icon); older systems use icon.icns -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- what macOS says when Spectrum first reaches into a folder kept by OneDrive, Dropbox, Google Drive or Synology Drive:
	     a project used there, or a copy 1.10 mirrored there, which the move to 2.0 looks through -->
	<key>NSFileProviderDomainUsageDescription</key>
	<string>Spectrum opens the projects you keep in this folder, and checks the copies Spectrum 1.10 kept here.</string>
</dict>
</plist>
