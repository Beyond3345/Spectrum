{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spectrum",
  "version": "2.0.3",
  "identifier": "com.beyond3345.spectrum",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "LaTeX writing workspace with an AI assistant",
    "longDescription": "A local LaTeX editor with AI assistance, compile and PDF preview, citations from a DOI or link, and version history.",
    "fileAssociations": [
      {
        "ext": ["tex", "ltx"],
        "name": "TeX document",
        "description": "TeX document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-tex"
      },
      {
        "ext": ["bib"],
        "name": "BibTeX bibliography",
        "description": "BibTeX bibliography",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-bibtex"
      },
      {
        "ext": ["sty", "cls", "clo", "dtx", "ins", "bst", "bbx", "cbx", "lbx", "dbx"],
        "name": "TeX file",
        "description": "TeX package, class or style",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["typ"],
        "name": "Typst document",
        "description": "Typst document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      }
    ],
    "copyright": "© 2025 OpenDCAI (OpenPrism) · © 2026 Beyond3345. MIT Licence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/texlab",
      "binaries/tectonic",
      "binaries/typst"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/data/": "data/",
      "resources/frontend/": "frontend/",
      "resources/templates/": "templates/",
      "resources/native/": "native/",
      "resources/dictionaries/": "dictionaries/",
      "resources/skills/": "skills/",
      "resources/engines/": "engines/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      },
      "dmg": {
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 190
        }
      }
    }
  }
}
