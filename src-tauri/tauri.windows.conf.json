{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tex", "ltx"],
        "name": "TeX document",
        "description": "TeX document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-tex"
      },
      {
        "ext": ["bib"],
        "name": "BibTeX bibliography",
        "description": "BibTeX bibliography",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-bibtex"
      }
    ],
    "resources": {
      "resources/engines/vcruntime140.dll": "vcruntime140.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
